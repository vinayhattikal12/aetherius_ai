# Aetherius AI Environment Configuration

PROJECT_NAME="Aetherius AI Core Platform"
VERSION="1.0.0"
ENVIRONMENT="development"

# PostgreSQL Database with pgvector
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aetherius"

# Optional Cloud Model API Keys (Falls back to Ollama and Local Synthesizer if empty)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
HF_TOKEN=""

# CORS Configuration (Restricted to local desktop and web client)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
AETHERIUS_LAUNCH_TOKEN=""
